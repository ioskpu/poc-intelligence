# Public observatory snapshot gateway used by the dashboard path in production.
POC_INTELLIGENCE_API_URL=https://api.example.internal

# Internal feature flag for the beta research layer.
POC_INTELLIGENCE_BETA_RESEARCH_ENABLED=false

# Legacy direct Futures Lab settings are retained for backend and beta workflows.
FUTURES_LAB_API_BASE_URL=https://example.internal
FUTURES_LAB_INTERNAL_API_KEY=replace-with-private-key
FUTURES_LAB_DATABASE_URL=postgresql://user:password@example.internal:5432/poc_intelligence
FUTURES_LAB_DASHBOARD_STATE_PATH=/the-private-dashboard-state-endpoint
FUTURES_LAB_REQUEST_TIMEOUT_MS=20000
